    `<div class="poweritem hazarditem"><span class="powericon">!</span><div><strong>RED / BLACK HAZARDS</strong><small>On contact: lose 25 points, 1.5 seconds, and 35% jump charge; your combo resets. More hazards appear as bosses get tougher.</small></div></div>`;
  function toggleSound(value){state.sound=value;$("#menuSound").textContent=`Sound: ${value?"On":"Off"}`;$("#soundToggle").checked=value;if(value)ensureAudio()}
  $("#menuSound").onclick=()=>toggleSound(!state.sound);$("#soundToggle").onchange=e=>toggleSound(e.target.checked);
  $("#brightness").oninput=e=>{state.brightness=Number(e.target.value)/100;$("#shade").style.filter=`brightness(${state.brightness})`};
  $("#shakeToggle").onchange=e=>state.shakeEnabled=e.target.checked;
  window.addEventListener("resize",resize);resize();requestAnimationFrame(frame);
})();
</script>
</body>
</html>
