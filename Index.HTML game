<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#100f1a">
<title>Super Hoops — Arcade Basketball</title>
<style>
:root{color-scheme:dark;--ink:#f7f1df;--muted:#a29cae;--gold:#ffca58;--coral:#ff665e;--panel:rgba(22,20,35,.84)}
*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:#100f1a;color:var(--ink);font-family:'Barlow Condensed',Arial,sans-serif}
body{min-height:100dvh}button,input{font:inherit}button{color:inherit}
#game{position:relative;width:100%;height:100%;isolation:isolate;background:#151523}
canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none}
#shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(ellipse at 50% 43%,transparent 34%,rgba(9,8,18,.28) 100%);transition:filter .25s}
.hud{position:absolute;z-index:2;inset:0;pointer-events:none;padding:clamp(12px,2.4vw,30px);display:none}
.topline{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.brand{font-size:clamp(22px,3vw,39px);line-height:.9;letter-spacing:.04em;font-weight:900;text-shadow:0 3px 14px #0008}
.brand small{display:block;color:var(--gold);font:500 10px 'DM Mono',monospace;letter-spacing:.2em;margin-top:7px}
.timerbox{text-align:center;min-width:84px;text-shadow:0 2px 10px #0009}
.timer{font:800 clamp(31px,4.2vw,52px)/.85 'Barlow Condensed';font-variant-numeric:tabular-nums;color:#fff}
.timer.low{color:#ff625d;animation:pulse .5s infinite alternate}
.timerlabel{font:10px 'DM Mono',monospace;letter-spacing:.2em;color:#d9d4db;margin-top:6px}
.scorebox{text-align:right;font-size:clamp(20px,2.8vw,34px);font-weight:800;line-height:.9;text-shadow:0 2px 10px #0009}
.scorebox small{display:block;font:10px 'DM Mono',monospace;color:#d0cad3;letter-spacing:.15em;margin-top:7px}
.bossbar{position:absolute;top:clamp(80px,11vh,112px);left:50%;transform:translateX(-50%);width:min(360px,48vw);text-align:center;text-shadow:0 2px 8px #000}
.bossname{font-weight:800;font-size:clamp(16px,2vw,22px);letter-spacing:.12em;text-transform:uppercase}
.bossmeter{height:9px;margin-top:6px;border:1px solid #fff9;border-radius:20px;background:#1a1025b3;overflow:hidden;box-shadow:0 2px 12px #0005}
.bossfill{height:100%;width:100%;background:linear-gradient(90deg,#ff4f69,#ffae4f);border-radius:20px;transition:width .25s}
.combo{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%) scale(.8);color:#fff092;font-weight:900;font-size:clamp(27px,5vw,55px);font-style:italic;opacity:0;text-shadow:0 3px 0 #af521f,0 6px 24px #000;transition:opacity .2s,transform .2s}
.combo.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.powerhud{position:absolute;bottom:clamp(14px,2vw,25px);left:50%;transform:translateX(-50%);border:1px solid #ffffff45;background:#151320b8;padding:8px 14px;border-radius:999px;font:11px 'DM Mono',monospace;white-space:nowrap;backdrop-filter:blur(8px)}
.powerhud b{color:var(--gold);font-weight:500}.pausebtn{pointer-events:auto;position:absolute;right:clamp(12px,2.4vw,30px);top:clamp(65px,8vh,88px);border:1px solid #ffffff55;background:#171421ad;border-radius:50%;width:38px;height:38px;font-size:16px;cursor:pointer}
.overlay{position:absolute;inset:0;z-index:4;display:grid;place-items:center;padding:18px;background:linear-gradient(180deg,rgba(10,9,17,.42),rgba(10,9,17,.76));backdrop-filter:blur(3px)}
.card{width:min(540px,94vw);max-height:92dvh;overflow:auto;background:linear-gradient(145deg,rgba(34,30,48,.96),rgba(18,17,29,.97));border:1px solid #ffffff2a;border-radius:24px;padding:clamp(22px,5vw,43px);box-shadow:0 28px 90px #0009;position:relative}
.card:before{content:"";position:absolute;inset:0 20% auto;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.eyebrow{font:11px 'DM Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:var(--gold)}
h1{font-size:clamp(58px,13vw,106px);line-height:.78;letter-spacing:-.04em;margin:15px 0 15px;font-weight:900;text-transform:uppercase}
h1 span{display:block;color:var(--gold);text-shadow:3px 4px 0 #a64c38}
.subtitle{color:#c2bdc9;font-size:17px;margin:17px 0 25px;line-height:1.25}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{border:0;border-radius:12px;padding:12px 19px;background:var(--gold);color:#261b20;font-weight:900;font-size:18px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;box-shadow:0 4px 0 #c58538;transition:transform .12s,filter .12s}
.btn:hover{filter:brightness(1.08);transform:translateY(-2px)}.btn:active{transform:translateY(2px);box-shadow:0 2px 0 #c58538}
.btn.secondary{background:#ffffff12;color:var(--ink);border:1px solid #ffffff33;box-shadow:none}
.tiny{font:10px 'DM Mono',monospace;color:#a49ead;letter-spacing:.1em;margin-top:18px}
.menu-links{display:flex;gap:9px;margin-top:19px;flex-wrap:wrap}
.menu-links button,.back{border:1px solid #ffffff2d;background:#ffffff0b;padding:8px 12px;border-radius:9px;color:#ddd5e2;font-weight:700;letter-spacing:.06em;cursor:pointer}
.menu-links button:hover,.back:hover{background:#ffffff19}
.hidden{display:none!important}
.subhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px}
.subhead h2{font-size:32px;margin:0;text-transform:uppercase;letter-spacing:.04em}
.list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.bossitem{padding:10px 12px;border:1px solid #ffffff15;background:#ffffff08;border-radius:10px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.bossitem strong{font-size:16px;text-transform:uppercase}.bossitem span{font:9px 'DM Mono',monospace;color:#a9a2b1}
.poweritem{padding:11px 12px;border:1px solid #ffffff18;background:#ffffff09;border-radius:11px;display:flex;align-items:center;gap:11px}
.powericon{width:30px;height:30px;flex:none;border-radius:50%;display:grid;place-items:center;font-weight:900;color:#201727}
.poweritem strong{display:block;font-size:16px;text-transform:uppercase;letter-spacing:.04em}
.poweritem small{display:block;color:#b5aebb;font-size:12px;line-height:1.2;margin-top:2px}
.hazarditem{border-color:#ff59653a;background:#42192328}.hazarditem .powericon{color:#ff6270;background:#24101b!important;border:1px solid #ff465b}
.guide{display:grid;gap:10px}.guide div,.settingrow{background:#ffffff09;border:1px solid #ffffff15;border-radius:12px;padding:12px 14px;color:#d5d0da}
.guide b{color:var(--gold)}.settingrow{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:9px 0}
.settingrow span{font-size:18px;font-weight:700}.settingrow small{display:block;font:10px 'DM Mono',monospace;color:#a49ead;margin-top:3px}
input[type=range]{accent-color:var(--gold);width:140px}.switch{accent-color:var(--gold);width:20px;height:20px}
.result{font-size:19px;color:#d1cad8;line-height:1.5;margin:10px 0 23px}.result strong{color:var(--gold)}
.toast{position:absolute;z-index:3;left:50%;top:27%;transform:translateX(-50%);padding:10px 18px;border-radius:999px;background:#171421dd;border:1px solid #ffffff45;color:#fff;font-weight:900;font-size:22px;letter-spacing:.12em;opacity:0;transition:opacity .2s;pointer-events:none;text-shadow:0 2px 8px #000}
.toast.show{opacity:1}
.mobilehint{display:none}
@keyframes pulse{to{transform:scale(1.07);text-shadow:0 0 18px #ff5a47}}
@media(max-width:600px){.list{grid-template-columns:1fr}.bossbar{top:94px}.brand{font-size:22px}.pausebtn{top:65px}.mobilehint{display:block}.subtitle{font-size:15px}.card{border-radius:18px}}
</style>
</head>
<body>
<main id="game">
  <canvas id="court" aria-label="Super Hoops basketball game"></canvas>
  <div id="shade"></div>
  <div class="hud" id="hud">
    <div class="topline">
      <div class="brand">SUPER HOOPS<small>ARCADE BOSS BRAWL</small></div>
      <div class="timerbox"><div class="timer" id="timer">30</div><div class="timerlabel">SECONDS</div></div>
      <div class="scorebox"><span id="score">0</span><small>SCORE &nbsp;·&nbsp; <span id="comboStat">0</span> COMBO</small></div>
    </div>
    <div class="bossbar"><div class="bossname" id="bossName">The Slime</div><div class="bossmeter"><div class="bossfill" id="bossFill"></div></div></div>
    <div class="combo" id="combo">NICE SHOT!</div>
    <div class="powerhud" id="powerHud">POWER-UP: <b>NONE</b></div>
    <button class="pausebtn" id="pauseBtn" aria-label="Pause">Ⅱ</button>
  </div>
  <div class="toast" id="toast"></div>
  <section class="overlay" id="overlay">
    <div class="card" id="mainMenu">
      <div class="eyebrow">A court full of chaos</div>
      <h1>SUPER<span>HOOPS</span></h1>
      <p class="subtitle">Bounce, charge, and shoot your way through 20 ridiculous bosses. The clock is ticking. Make every shot count.</p>
      <div class="actions"><button class="btn" id="startBtn">Tip off <span aria-hidden="true">→</span></button><button class="btn secondary" id="menuSound">Sound: On</button></div>
      <div class="menu-links"><button data-panel="bestiary">20-boss bestiary</button><button data-panel="controls">How to play</button><button data-panel="powers">Power-ups &amp; hazards</button><button data-panel="settings">Settings</button></div>
      <div class="tiny">← → / A D MOVE &nbsp;·&nbsp; HOLD SPACE, RELEASE TO JUMP &nbsp;·&nbsp; P PAUSE</div>
    </div>
    <div class="card hidden" id="bestiary">
      <div class="subhead"><h2>Bestiary</h2><button class="back">← Back</button></div>
      <p class="subtitle">Twenty court-crashing weirdos. Each one gets faster, tougher, and a little less fair.</p>
      <div class="list" id="bossList"></div>
    </div>
    <div class="card hidden" id="controls">
      <div class="subhead"><h2>How to play</h2><button class="back">← Back</button></div>
      <div class="guide">
        <div><b>MOVE</b> — A / D or ← / → to steer your ball across the court.</div>
        <div><b>CHARGE & JUMP</b> — Hold Space, then release to launch. Longer charge = higher jump. Your ball bounces automatically.</div>
        <div><b>SCORE</b> — Sink a shot through either moving hoop. Every basket damages the boss and adds 4 seconds (up to 30).</div>
        <div><b>POWER-UPS</b> — Grab the glowing drops. Avoid red hazards and the boss's flailing hands.</div>
        <div class="mobilehint"><b>TOUCH</b> — Drag to steer, tap and hold anywhere to charge, release to jump.</div>
      </div>
    </div>
    <div class="card hidden" id="powers">
      <div class="subhead"><h2>Power-ups &amp; hazards</h2><button class="back">← Back</button></div>
      <p class="subtitle">Grab the glowing drops for an edge. Steer clear of the red-and-black hazards.</p>
      <div class="list" id="powerList"></div>
    </div>
    <div class="card hidden" id="settings">
      <div class="subhead"><h2>Settings</h2><button class="back">← Back</button></div>
      <label class="settingrow"><span>Sound<small>Procedural arcade effects</small></span><input class="switch" id="soundToggle" type="checkbox" checked></label>
      <label class="settingrow"><span>Brightness<small>Adjust court lighting</small></span><input id="brightness" type="range" min="65" max="135" value="100"></label>
      <div class="settingrow"><span>Motion<small>Screen shake on big shots</small></span><input class="switch" id="shakeToggle" type="checkbox" checked></div>
    </div>
    <div class="card hidden" id="endMenu">
      <div class="eyebrow" id="endEyebrow">Final buzzer</div><h2 id="endTitle" style="font-size:54px;line-height:.9;margin:15px 0">GAME OVER</h2>
      <p class="result" id="endResult"></p><div class="actions"><button class="btn" id="retryBtn">Run it back ↻</button><button class="btn secondary" id="homeBtn">Main menu</button></div>
    </div>
    <div class="card hidden" id="pauseMenu">
      <div class="eyebrow">Timeout</div><h2 style="font-size:58px;margin:12px 0">PAUSED</h2><p class="subtitle">Catch your breath. The bosses won't.</p>
      <div class="actions"><button class="btn" id="resumeBtn">Back to court</button><button class="btn secondary" id="pauseSettingsBtn">Settings</button><button class="btn secondary" id="quitBtn">Quit game</button></div>
    </div>
  </section>
</main>
<script>
(() => {
  "use strict";
  const canvas=document.getElementById("court"),ctx=canvas.getContext("2d");
  const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
  const bossNames=["The Slime","Sir Bounce","Magma Mutt","The Mummy","Frost Fang","Robo Raptor","Goozilla","Baron Von Bat","The Cyclops","Mimic Cube","Vampire Vex","Mecha-Mantis","Thunder Toad","The Phantom","Kraken Jr.","Doom Diver","Cyber-Skull","Bone Dragon","Neon Hydra","The Final Boss"];
  const bossColors=["#7ce89b","#f8b85b","#fc6d54","#ddc28f","#93e8ff","#88a7ff","#63dab8","#db78bd","#f8d463","#b899f2","#e76b7d","#74dfda","#b7e758","#b6a8ff","#64b9d1","#fa8e53","#e752ee","#f27b63","#70f3ff","#ffca58"];
  const powerDefs=[
    {name:"HOOP FREEZE",color:"#48baff",symbol:"❄",duration:6,desc:"Hoops frozen"},
    {name:"BOSS SLOW",color:"#c274ff",symbol:"◉",duration:7,desc:"Boss slowed"},
    {name:"MULTI-BALL",color:"#ffd35a",symbol:"✦",duration:8,desc:"Clone ball"},
    {name:"TIME REWIND",color:"#65e49a",symbol:"↶",duration:0,desc:"Movement rewound"},
    {name:"SHIELD",color:"#ff9a4c",symbol:"⬡",duration:9,desc:"Shield active"},
    {name:"DOUBLE POINTS",color:"#ff72bd",symbol:"×2",duration:9,desc:"Double points"}
  ];
  const state={mode:"menu",w:0,h:0,dpr:1,last:0,elapsed:0,time:30,score:0,combo:0,level:0,bossHp:100,shake:0,shakeEnabled:true,sound:true,brightness:1,power:null,powerLeft:0,powerSpawn:5,hazardSpawn:3,toastLeft:0,charge:0,charging:false,keys:{},trail:[],particles:[],clones:[],history:[],scoredLock:0,bestCombo:0};
  const ball={x:0,y:0,prevY:0,vx:0,vy:0,r:17,grounded:false,spin:0};
  const hoops=[{side:"left",x:0,y:0,base:0,phase:0,vy:0,netSway:0,netPulse:0},{side:"right",x:0,y:0,base:0,phase:2,vy:0,netSway:0,netPulse:0}];
  const boss={x:0,y:0,vx:0,phase:0,hands:[]};
  let audio=null,canvasRect;

  function resize(){
    state.dpr=Math.min(window.devicePixelRatio||1,2);
    state.w=window.innerWidth;state.h=window.innerHeight;
    canvas.width=Math.round(state.w*state.dpr);canvas.height=Math.round(state.h*state.dpr);
    canvas.style.width=state.w+"px";canvas.style.height=state.h+"px";
    ctx.setTransform(state.dpr,0,0,state.dpr,0,0);
    const floor=floorY();
    hoops[0].x=Math.max(48,state.w*.095);hoops[1].x=state.w-Math.max(48,state.w*.095);
    hoops.forEach(h=>{h.base=state.h*.56; if(!h.y)h.y=h.base;});
    if(!ball.x){ball.x=state.w*.5;ball.y=floor-80;}
    boss.y=state.h*.49;
  }
  function makeSwoosh(hoop,shot=ball){
    const palette=["#fff4c4","#ffe17b","#fff","#ffb65c","#ff7690","#8deeff"];
    for(let i=0;i<42;i++){
      const a=Math.random()*Math.PI*2,speed=100+Math.random()*410;
      state.particles.push({kind:"swoosh",x:hoop.x+(Math.random()-.5)*34,y:hoop.y+12+Math.random()*25,
        vx:Math.cos(a)*speed+shot.vx*.28,vy:Math.sin(a)*speed-180-shot.vy*.14,
        spin:(Math.random()-.5)*16,rotation:Math.random()*Math.PI*2,
        life:.5+Math.random()*.72,maxLife:1.22,size:2+Math.random()*5,color:palette[i%palette.length]});
    }
    for(let i=0;i<10;i++){
      const side=i%2?1:-1;
      state.particles.push({kind:"swoosh",x:hoop.x+side*(8+Math.random()*8),y:hoop.y+Math.random()*26,
        vx:side*(90+Math.random()*180),vy:-80-Math.random()*210,spin:side*(3+Math.random()*7),
        rotation:Math.random()*Math.PI,life:.65+Math.random()*.35,maxLife:1,size:3+Math.random()*3,color:i%2?"#fff1a0":"#fff"});
    }
  }
  function resolveRimCrossing(shot,prevY,hoop){
    if(shot.vy<=0||prevY+shot.r>=hoop.y||shot.y+shot.r<hoop.y)return false;
    const offset=shot.x-hoop.x;
    if(Math.abs(offset)<=8){
      scoreBasket(hoop,shot);
      shot.vy=Math.max(95,shot.vy*.72);
      shot.vx*=.88;
      return true;
    }
    if(Math.abs(offset)<25+shot.r){
      shot.y=hoop.y-shot.r;
      shot.vy=-Math.max(125,Math.abs(shot.vy)*.48);
      shot.vx+=Math.sign(offset||1)*65;
      sound("bounce");pop(hoop.x+Math.sign(offset)*21,hoop.y,"#ff9b69",5);
      return true;
    }
    return false;
  }
  function floorY(){return state.h*.87}
  function ensureAudio(){if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==="suspended")audio.resume();}
  function tone(freq,duration,type="sine",vol=.045,slide=0){
    if(!state.sound)return;ensureAudio();
    const o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(freq,audio.currentTime);
    if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(30,freq+slide),audio.currentTime+duration);
    g.gain.setValueAtTime(vol,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);
    o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+duration);
  }
  function sound(kind){if(!state.sound)return;if(kind==="bounce")tone(170,.09,"sine",.035,-50);if(kind==="jump")tone(240,.23,"triangle",.06,390);if(kind==="score"){tone(520,.14,"triangle",.06,260);setTimeout(()=>tone(780,.24,"sine",.06,230),90)}if(kind==="hit")tone(105,.2,"sawtooth",.06,-45);if(kind==="power")tone(390,.32,"sine",.05,520);}
  function showToast(text,color="#fff"){const el=$("#toast");el.textContent=text;el.style.color=color;el.classList.add("show");state.toastLeft=1.35;}
  function showOverlay(id){$$(".card").forEach(c=>c.classList.add("hidden"));$("#overlay").classList.remove("hidden");$("#"+id).classList.remove("hidden");}
  function hideOverlay(){$("#overlay").classList.add("hidden");}
  let panelReturn="mainMenu";
  function openPanel(id,returnTo="mainMenu"){panelReturn=returnTo;showOverlay(id)}
  function startGame(){
    ensureAudio();state.mode="playing";state.time=30;state.score=0;state.combo=0;state.bestCombo=0;state.level=0;state.bossHp=100;state.power=null;state.powerLeft=0;state.elapsed=0;state.particles=[];state.clones=[];state.trail=[];state.history=[];state.charge=0;state.scoredLock=0;state.hazardSpawn=2;state.powerSpawn=4;
    ball.x=state.w*.5;ball.y=floorY()-90;ball.vx=0;ball.vy=-60;boss.x=state.w*.5;boss.y=state.h*.47;boss.vx=0;
    hoops.forEach((h,i)=>{h.y=h.base;h.phase=i*2;});$("#hud").style.display="block";hideOverlay();updateHud();
  }
  function gameOver(victory=false){
    state.mode="end";$("#hud").style.display="none";$("#endEyebrow").textContent=victory?"Court legend":"Final buzzer";$("#endTitle").textContent=victory?"YOU WIN!":"TIME'S UP";
    $("#endResult").innerHTML=`Final score: <strong>${state.score}</strong><br>Bosses defeated: <strong>${state.level} / 20</strong><br>Best combo: <strong>${state.bestCombo||state.combo}</strong>`;
    showOverlay("endMenu");
  }
  function updateHud(){
    $("#score").textContent=state.score.toLocaleString();$("#comboStat").textContent=state.combo;
    const t=$("#timer");t.textContent=Math.ceil(state.time);t.classList.toggle("low",state.time<10);
    $("#bossName").textContent=bossNames[Math.min(state.level,19)];$("#bossFill").style.width=Math.max(0,state.bossHp)+"%";
    $("#powerHud").innerHTML=state.power?`POWER-UP: <b style="color:${state.power.color}">${state.power.name} · ${Math.ceil(state.powerLeft)}s</b>`:"POWER-UP: <b>NONE</b>";
  }
  function scoreBasket(hoop,shot=ball){
    if(state.scoredLock>0)return;
    state.scoredLock=.9;state.combo++;state.bestCombo=Math.max(state.bestCombo||0,state.combo);
    const points=(100+state.level*25)*(state.power&&state.power.name==="DOUBLE POINTS"?2:1);
    state.score+=points;state.time=Math.min(30,state.time+4);
    state.bossHp-=Math.max(14,32-state.level*.8);
    state.shake=state.shakeEnabled?Math.min(16,6+state.combo):0;
    showToast(state.combo>1?`SWOOSH!  +${points}  ×${state.combo}`:`SWOOSH!  +${points}`, "#fff09a");
    hoop.netSway+=Math.max(-18,Math.min(18,shot.vx*.035));hoop.netPulse=1;
    makeSwoosh(hoop,shot);sound("score");
    if(state.bossHp<=0){
      state.level++;state.bossHp=100;
      if(state.level>=20){updateHud();gameOver(true);return}
      showToast(`${bossNames[state.level-1].toUpperCase()} DOWN!`,bossColors[state.level-1]);tone(240,.48,"sawtooth",.07,500);
      boss.x=state.w*.5;boss.vx=(Math.random()-.5)*100;
    }
    updateHud();
  }
  function pop(x,y,color,n=12){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=50+Math.random()*240;state.particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-50,life:.45+Math.random()*.7,max:.8,size:2+Math.random()*5,color});}}
  function spawnPower(){
    if(state.particles.some(p=>p.kind==="power"))return;
    const def=powerDefs[Math.floor(Math.random()*powerDefs.length)];
